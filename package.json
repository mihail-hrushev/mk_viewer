{
  "name": "mk-viewer",
  "version": "0.1.0",
  "description": "Fast, dependency-free WebGL2 3D viewer for very large scenes with a runtime geometry API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/mk-viewer.umd.cjs",
  "module": "./dist/mk-viewer.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mk-viewer.js",
      "require": "./dist/mk-viewer.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
